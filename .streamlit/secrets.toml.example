# Copy to .streamlit/secrets.toml for local use, or paste into
# Streamlit Community Cloud -> your app -> Settings -> Secrets.
# Every entry is optional.

# Ask for a password before anyone can use the app (recommended when deployed).
APP_PASSWORD = "choose-a-password"

# Enables the optional AI interpretation. Billed per use by Anthropic.
# Leave it out to keep the app completely free.
# ANTHROPIC_API_KEY = "sk-ant-..."

# Optional model override (default: claude-opus-5-5).
# ANTHROPIC_MODEL = "claude-haiku-5-5"
